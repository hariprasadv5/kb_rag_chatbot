# ---- copy to .env and fill in ----
OPENAI_API_KEY=sk-...
COHERE_API_KEY=...

# LangSmith tracing (every step of every answer becomes a trace)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=kb-chatbot
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your LangSmith org is in the EU region

# models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# retrieval knobs
RERANKER=cohere            # cohere | cross-encoder | none
COHERE_RERANK_MODEL=rerank-v3.5
DENSE_K=50
BM25_K=50
RRF_K=60
FINAL_K=5
MIN_RERANK_SCORE=0.05      # below this the bot abstains instead of guessing

# storage
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=company_kb
RAPTOR_COLLECTION=company_kb_raptor
DEFAULT_TENANT=northwind
